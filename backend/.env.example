SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-a-server-side-service-role-key
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-a-current-groq-model-id

# Optional: comma-separated origins allowed to call the Flask API.
ALLOWED_ORIGINS=http://localhost:5173

# Optional n8n integration. Leave unset to disable internal endpoints.
# N8N_SECRET=replace-with-a-long-random-shared-secret
# N8N_UPLOAD_WEBHOOK_URL=https://your-n8n.example/webhook/upload-alert
# AUTO_UPLOAD_EMAILS=allowed-user@example.com
# GROQ_FALLBACK_MODEL=replace-with-another-current-model-id
